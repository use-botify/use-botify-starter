{
  "name": "use-botify",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "docs:generate": "repomix"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@ianvs/prettier-plugin-sort-imports": "4.4.0",
    "@types/node": "24.0.0",
    "eslint": "9.15.0",
    "eslint-config-prettier": "9.1.0",
    "globals": "15.12.0",
    "prettier": "3.3.3",
    "repomix": "0.2.15",
    "typescript": "5.7.2",
    "typescript-eslint": "8.15.0"
  }
}