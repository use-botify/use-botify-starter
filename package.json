{
	"name": "use-botify-starter",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/main.ts",
		"start": "tsx src/main.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint",
		"format": "biome format --write",
		"check": "biome check --write",
		"postinstall": "prisma generate",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"clean:modules": "tsx scripts/clean-modules.ts",
		"docs:generate": "repomix",
		"check:all": "tsx scripts/check-and-fix.ts"
	},
	"dependencies": {
		"@grammyjs/auto-retry": "2.0.2",
		"@grammyjs/runner": "2.0.3",
		"@prisma/adapter-pg": "7.10.1",
		"@prisma/client": "7.10.1",
		"chalk": "6.0.1",
		"dotenv": "18.0.8",
		"grammy": "1.46.0",
		"pg": "8.23.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/cross-spawn": "6.0.6",
		"@types/node": "26.6.5",
		"@types/pg": "8.23.1",
		"cross-spawn": "7.0.6",
		"prisma": "7.10.1",
		"repomix": "1.18.1",
		"tsx": "4.23.15",
		"typescript": "7.0.2"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.14.0",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.14.0"
}
