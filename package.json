{
  "name": "use-botify",
  "version": "1.0.0",
  "private": true,
  "description": "Modular TypeScript framework and CLI scaffolder for grammY Telegram bots with Vite HMR.",
  "license": "MIT",
  "author": {
    "name": "Sahil Kumar",
    "url": "https://sahilkumar.axisbuddy.com"
  },
  "homepage": "https://github.com/use-botify/use-botify-starter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/use-botify/use-botify-starter.git"
  },
  "bugs": {
    "url": "https://github.com/use-botify/use-botify-starter/issues"
  },
  "keywords": [
    "use-botify",
    "create-use-botify",
    "telegram-bot",
    "grammy",
    "typescript",
    "vite",
    "hmr",
    "cli",
    "file-based-routing",
    "telegram-custom-emoji"
  ],
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "preinstall": "node scripts/only-pnpm.mjs",
    "dev:cli": "pnpm --filter create-use-botify dev",
    "dev:web": "pnpm --filter web dev",
    "build": "turbo run build",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "test": "turbo run test",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "script:check:all": "tsx --conditions=source scripts/fix-and-clean.mts",
    "script:clean:modules": "tsx scripts/clean-modules.mts",
    "script:generate:docs": "tsx scripts/generate-context.mts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "catalog:",
    "@workspace/logger": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/utils": "workspace:*",
    "cross-spawn": "7.0.6",
    "repomix": "1.19.0",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
