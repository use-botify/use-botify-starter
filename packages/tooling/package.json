{
  "name": "@use-botify/tooling",
  "version": "0.1.0",
  "description": "Development HMR, route typegen, and registry codegen utilities for the Botify Telegram framework",
  "license": "MIT",
  "author": "Sahil Kumar",
  "homepage": "https://github.com/use-botify/use-botify-starter/tree/main/packages/tooling#readme",
  "bugs": {
    "url": "https://github.com/use-botify/use-botify-starter/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/use-botify/use-botify-starter.git",
    "directory": "packages/tooling"
  },
  "keywords": [
    "telegram",
    "telegram-bot",
    "grammy",
    "botify",
    "hmr",
    "vite",
    "codegen",
    "typegen",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hmr": {
      "types": "./dist/hmr.d.ts",
      "import": "./dist/hmr.js"
    },
    "./codegen": {
      "types": "./dist/codegen.d.ts",
      "import": "./dist/codegen.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "@use-botify/router": ">=0.1.0 <1.0.0",
    "vite": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "@use-botify/router": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@use-botify/router": "workspace:*",
    "@workspace/tsdown-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/utils": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "grammy": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": ">=6.0.0",
    "vitest": "catalog:"
  }
}
