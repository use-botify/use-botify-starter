{
  "name": "@use-botify/plugins",
  "version": "0.1.0",
  "description": "Optional runtime plugins (image caching, UI panels, and custom emoji tools) for the Botify Telegram framework",
  "license": "MIT",
  "author": "Sahil Kumar",
  "homepage": "https://github.com/use-botify/use-botify-starter/tree/main/packages/plugins#readme",
  "bugs": {
    "url": "https://github.com/use-botify/use-botify-starter/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/use-botify/use-botify-starter.git",
    "directory": "packages/plugins"
  },
  "keywords": [
    "telegram",
    "telegram-bot",
    "grammy",
    "botify",
    "plugins",
    "images",
    "panels",
    "custom-emoji",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./images": {
      "types": "./dist/images.d.ts",
      "import": "./dist/images.js"
    },
    "./panels": {
      "types": "./dist/panels.d.ts",
      "import": "./dist/panels.js"
    },
    "./icon-tools": {
      "types": "./dist/icon-tools.d.ts",
      "import": "./dist/icon-tools.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "grammy": ">=1.30.0 <2.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/tsdown-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/utils": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "grammy": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
