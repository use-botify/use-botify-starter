{
  "name": "create-use-botify",
  "version": "0.1.0",
  "description": "Scaffold a modular, Next.js-style Telegram bot powered by the Botify framework and grammY",
  "license": "MIT",
  "author": "Sahil Kumar",
  "homepage": "https://github.com/use-botify/use-botify-starter/tree/main/apps/create-use-botify#readme",
  "bugs": {
    "url": "https://github.com/use-botify/use-botify-starter/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/use-botify/use-botify-starter.git",
    "directory": "apps/create-use-botify"
  },
  "keywords": [
    "telegram",
    "telegram-bot",
    "grammy",
    "botify",
    "use-botify",
    "create-use-botify",
    "cli",
    "scaffolding",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "bin": {
    "create-use-botify": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "1.9.0",
    "chalk": "6.0.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/tsdown-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/utils": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
