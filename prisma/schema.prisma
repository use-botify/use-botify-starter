generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        BigInt   @id
  username  String?
  firstName String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([isActive, id])
  @@index([createdAt])
  @@map("user")
}
